rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── User photos — UID-scoped access ───────────────────────────────────
    // Path: /users/{uid}/photos/{filename}
    // Only the owning user can read or write their own photos
    match /users/{uid}/photos/{filename} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    // ── User avatar ───────────────────────────────────────────────────────
    // Path: /users/{uid}/avatar.jpg
    // Owner can write; any authenticated user can read (for feed display)
    match /users/{uid}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Default deny — block all other paths ─────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
