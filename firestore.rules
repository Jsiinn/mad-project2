rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────
    // Only the owning user can read or write their profile document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Workouts ─────────────────────────────────────────────────────────
    // Users can only read/write their own workout documents
    // Cloud Functions (Admin SDK) bypass these rules automatically
    match /workouts/{workoutId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.uid;

      // Allow create: validate uid matches auth token on new docs
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    // ── Feed ─────────────────────────────────────────────────────────────
    // Feed posts are publicly readable by any authenticated user
    // But only the post owner can write/update their own post
    match /feed/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;

      // Allow likes update (array union/remove on 'likes' field only)
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    // ── Challenges ────────────────────────────────────────────────────────
    // All authenticated users can read challenges
    // Only the creator can write/update; participants can join (add themselves)
    match /challenges/{challengeId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.creatorUid;

      // Allow update only if: creator updating, OR only 'participants' field changed (join)
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.creatorUid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']));
    }

    // ── Notifications ─────────────────────────────────────────────────────
    // Users can only read their own notifications (Cloud Functions write them)
    match /notifications/{notifId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.recipientUid;
      allow write: if false; // Cloud Functions (Admin SDK) only
    }
  }
}
